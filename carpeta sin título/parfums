  {id:46, n:"Teriaq Intense",p3:100,p5:150,c:"Arabe",s:"Disponible", casa:"Lattafa"},
  {id:47, n:"L’Aventure",p3:100,p5:150,c:"Arabe",s:"Disponible", casa:"French Avenue"},
  {id:48, n:"Hiss Confession",p3:80,p5:140,c:"Arabe",s:"Disponible", casa:"Lattafa"}
];

let cart = [];
let currentPage = 1;
const itemsPerPage = 16;
let filteredList = [...perfumes];

function resetPage() { currentPage = 1; }

function filtrarCatalogo() {
  const query = document.getElementById("searchInput").value.toLowerCase();
  const cat = document.getElementById("filterCat").value;
  const casa = document.getElementById("filterCasa").value;
  const status = document.getElementById("filterStatus").value;

  filteredList = perfumes.filter(p => {
    const matchNombre = p.n.toLowerCase().includes(query);
    const matchCat = (cat === "Todos" || p.c === cat);
    const matchCasa = (casa === "Todos" || p.casa === casa);
    const matchStatus = (status === "Todos" || p.s === status);
    return matchNombre && matchCat && matchCasa && matchStatus;
  });
  render();
}

function render() {
  const grid = document.getElementById("grid");
  const pagination = document.getElementById("pagination");
  grid.innerHTML = "";
  
  const start = (currentPage - 1) * itemsPerPage;
  const end = start + itemsPerPage;
  const paginatedItems = filteredList.slice(start, end);

  paginatedItems.forEach((p) => {
    grid.innerHTML += `
    <div class="card">
      <div class="image"><img src="Perfume${p.id}.jpg" alt="${p.n}"></div>
      <div class="name">${p.n}</div>
      <button class="btn-buy" onclick="addToCart('${p.n}','3 ml',${p.p3})">3ml $${p.p3}</button>
      <button class="btn-buy" onclick="addToCart('${p.n}','5 ml',${p.p5})">5ml $${p.p5}</button>
    </div>`;
  });

  const totalPages = Math.ceil(filteredList.length / itemsPerPage);
  pagination.innerHTML = "";
  if(totalPages > 1){
    for (let i = 1; i <= totalPages; i++) {
      pagination.innerHTML += `<button class="page-btn ${i === currentPage ? 'active' : ''}" onclick="changePage(${i})">${i}</button>`;
    }
  }
}

function changePage(page) {
  currentPage = page;
  render();
  window.scrollTo(0,0);
}

function openCart(){ document.getElementById("cartOverlay").style.display="block"; }
function closeCart(){ document.getElementById("cartOverlay").style.display="none"; }
function addToCart(name,size,price){
  cart.push({name,size,price});
  renderCart();
  document.getElementById("cartCount").innerText = cart.length;
}
function removeItem(i){
  cart.splice(i,1);
  renderCart();
  document.getElementById("cartCount").innerText = cart.length;
}
function renderCart(){
  const list = document.getElementById("cartList");
  list.innerHTML="";
  let total=0;
  cart.forEach((item,index)=>{
    total+=item.price;
    list.innerHTML+=`<li><span>${item.name} (${item.size})</span><span>$${item.price} <span style="color:red; cursor:pointer;" onclick="removeItem(${index})">✖</span></span></li>`;
  });
  document.getElementById("cartTotal").innerText=`Total: $${total}`;
}

document.getElementById('btnRealizarPedido').addEventListener('click', function() {
  if(cart.length === 0) {
    alert("Tu carrito está vacío");
    return;
  }
  let texto = "Hola R Luxe Parfums 👋\nQuiero hacer este pedido:\n\n";
  let granTotal = 0;
  cart.forEach(item => {
    texto += `• ${item.name} (${item.size}) - $${item.price}\n`;
    granTotal += item.price;
  });
  texto += `\n💰 Total: $${granTotal}`;
  const url = "https://wa.me/528442726710?text=" + encodeURIComponent(texto);
  window.location.href = url;
});

filtrarCatalogo();
</script>
